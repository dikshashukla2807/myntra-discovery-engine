# Copy to .env and fill values as needed.
# The app runs in Demo Mode with no keys.

# Dataset: demo | public
# demo  = labeled sample observations (never presented as real research)
# public = collected public-source user-generated content
DATASET_MODE=public

# Optional LLM for classification, extraction, theme naming, interview questions.
# If unset, the engine uses cached/heuristic fallbacks. Never fabricates source text.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional YouTube Data API v3. If unset, use CSV/JSON import for YouTube comments.
YOUTUBE_API_KEY=

# Optional Reddit (public JSON works without these; OAuth increases rate limits)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=MyntraDiscoveryEngine/1.0 (academic product research)

# Collection targets (not guaranteed; never fabricate to fill gaps)
PLAY_REVIEW_TARGET=3000
APP_STORE_REVIEW_TARGET=1000
REDDIT_TARGET=300
YOUTUBE_TARGET=500

# Pipeline
SAMPLE_SIZE=0
FORCE_REPROCESS=false
CLUSTER_COUNT=12

# Server
API_HOST=127.0.0.1
API_PORT=43124
CORS_ORIGINS=http://127.0.0.1:43125,http://localhost:43125
